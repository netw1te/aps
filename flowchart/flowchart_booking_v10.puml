@startuml flowchart_booking_v10
title Flowchart с дорожками — бронирование билетов (вариант 10)

|Ядро|
|Источник|
|ДП|
|ДВ|
|Прибор|
|Статистика|
|Ядро|
start
:N := 100, p_prev := не задано, done := false;

repeat
  :t := 0, generated := 0,
  буфер пуст, все приборы свободны,
  ptr Д2П2 := 0, пакет Д2Б5 пуст,
  статистика и журнал обнулены;
  :для каждого источника i планируем ARRIVAL(i)
  в момент U[a, b];

  while (календарь событий не пуст?) is (да)
    :ev := calendar.pop();

    :t := ev.time;

      if (ev.kind = ARRIVAL?) then (ARRIVAL)
        |Источник|
        :ИБ, ИЗ2: req := buildRequest(t)
        номер (i.j), Tвх = t;
        |Статистика|
        :onGenerated(req), журнал GENERATED;
        |Ядро|
        :generated := generated + 1;
        if (generated < N?) then (да)
          :планируем следующий ARRIVAL(i)
          в момент t + U[a, b];
        else (нет)
          :последняя заявка: calendar.removeAll(ARRIVAL),
          новые ARRIVAL не планируются;
        endif

        |ДП|
        :Д1ОЗ3: slot := findSlot(buffer)
первое свободное место;
        if (slot найден?) then (да, HappyFlow по буферу)
          :place(slot, req), без сдвига,
          req.markQueued(t), журнал BUFFERED;
        else (нет, буфер полон)
          :Д1ОО2: victim := chooseVictim(buffer, req)
          слабейшая заявка буфера: наибольший номер
          источника, среди равных самая поздняя;
          if (victim = req?) then (да, номер req >= номера слабейшей)
            :req.markRejected(t);
            |Статистика|
            :onRejected(req), журнал REJECTED_NEW;
          else (нет, выбивание)
            |ДП|
            :victim.markRejected(t),
            slot := slotOf(victim), takeOut(slot),
            place(slot, req), req.markQueued(t),
            журнал BUFFERED;
            |Статистика|
            :onRejected(victim), журнал EVICTED;
          endif
        endif

      else (RELEASE)
        |Прибор|
        :ПЗ1: served := servers[d].complete(t),
        served.markServed(), прибор d свободен;
        |Статистика|
        :onServed(served), журнал SERVED;
      endif

      |ДВ|
      :триггер: после ARRIVAL или RELEASE;
      while (буфер не пуст и есть свободный прибор?) is (да)
        repeat
          if (пакет пуст?) then (да)
            :Д2Б5: формируем пакет, снимок заявок
            источника с наименьшим номером, FIFO;
          else (нет)
          endif
          :req := первая заявка пакета;
        repeat while (заявка выбита, state = REJECTED?) is (да) not (нет)
        :Д2П2: d := pickDevice(servers)
        поиск по кольцу от ptr;
        |Прибор|
        :isIdle() у приборов по кольцу,
        первый свободный прибор d;
        |ДВ|
        :ptr := (d + 1) mod m, внутри pickDevice;
        :takeOut(slotOf(req)),
        журнал PICKED_FROM_PACKAGE;
        |Прибор|
        :endAt := servers[d].beginService(req, t)
        req.markServing(t, endAt), время по ПЗ1;
        |ДВ|
        :calendar.push(RELEASE(d, endAt)),
        журнал SENT_TO_DEVICE;
      endwhile (нет)

      |Статистика|
      if (пошаговый режим?) then (да)
        :ОД1: календарь событий (таблица), буфер,
        приборы, pointer, пакет, доля отказов;
      else (нет)
      endif
  endwhile (нет)

  |Ядро|
  :T_реал := t,
  p := число отказов / N;
  if (p_prev задано и abs(p_prev − p) <= 0.1 · p_prev?) then (да)
    :done := true;
  else (нет)
    :p_prev := p;
    if (p = 0?) then (да)
      :N := 2 · N;
    else (нет)
      :N := ceil(1.643² · (1 − p) / (0.1² · p));
    endif
  endif
repeat while (done = false?) is (да) not (нет)

|Статистика|
:ОР1: Таблица 1 по источникам,
Таблица 2 по приборам, Kисп = busyTotal / T_реал;
stop
@enduml
