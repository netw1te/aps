@startuml sequence_booking_v10
title Бронирование билетов — сценарии работы модели (вариант 10)
autonumber

participant "Календарь\nсобытий" as Cal
participant "Источник\n(ИБ, ИЗ2)" as Src
participant "Диспетчер\nпостановки (ДП)" as DP
database "Буфер\n(Д1ОЗ3)" as Buf
participant "Диспетчер\nвыбора (ДВ)" as DV
participant "Прибор\n(ПЗ1)" as Dev
participant "Статистика\n(ОР1)" as St

== A. Приход заявки: событие ARRIVAL(i, t) ==

Cal -> Src : ARRIVAL(i, t)
Src -> Src : buildRequest(t), номер (i.j), Tвх = t
Src -> St : onGenerated(req)

opt generated < N
  Src -> Cal : push ARRIVAL(i, t + U[a, b])
end

Src -> DP : onArrival(req, t)
DP -> Buf : firstEmptySlot()
Buf --> DP : slot | NONE

alt есть свободное место (Д1ОЗ3)
  DP -> Buf : place(slot, req)
else буфер полон (Д1ОО2)
  DP -> DP : chooseVictim(buffer, req)
  alt victim = req (новая заявка приоритетом ниже всех)
    DP -> St : onRejected(req)
  else victim — заявка из буфера
    DP -> DV : onEvicted(victim)
    DP -> St : onRejected(victim)
    DP -> Buf : takeOut(slotOf(victim))
    DP -> Buf : place(slot, req)
  end
end

DP -> DV : dispatch(t)
ref over DV, Buf, Dev, Cal : B. Передача заявок на приборы

== B. Передача заявок на приборы: dispatch(t) ==

loop пока буфер не пуст и есть свободный прибор
  DV -> DV : next(buffer) — Д2Б5: пакет приоритетного источника
  DV -> DV : pickDevice(servers) — Д2П2: поиск по кольцу от pointer
  DV -> DV : pointer = (d + 1) mod m
  DV -> Buf : takeOut(slotOf(req))
  Buf --> DV : req
  DV -> Dev : beginService(req, t)
  Dev --> DV : endAt
  DV -> Cal : push RELEASE(d, endAt)
end

== C. Завершение обслуживания: событие RELEASE(d, t) ==

Cal -> Dev : RELEASE(d, t)
Dev -> Dev : complete(t)
Dev --> Cal : served_req
Cal -> St : onServed(served_req)
Cal -> DV : dispatch(t)
ref over DV, Buf, Dev, Cal : B. Передача заявок на приборы

note over DP, Buf
Д1ОЗ3: постановка на первое свободное место, сдвига очереди нет.
Д1ОО2: при полном буфере отказ получает заявка источника с наибольшим
номером (низший приоритет); среди равных — самая поздняя.
Заявки на приборах не вытесняются.
end note

note over DV, Dev
Д2Б5: когда пакет пуст, фиксируется снимок заявок приоритетного источника;
новые заявки этого источника в пакет не добавляются.
Д2П2: свободный прибор ищется по кольцу от pointer, затем pointer = (d + 1) mod m.
end note

@enduml
