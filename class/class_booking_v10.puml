@startuml class_booking_v10
title Диаграмма классов — бронирование билетов (вариант 10)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "Данные" {
  class SimulationConfig {
    - sourceCount: int
    - deviceCount: int
    - bufferCapacity: int
    - a: double
    - b: double
    - mu: double
    - totalRequests: int
    --
    + getSourceCount(): int
    + getDeviceCount(): int
    + getBufferCapacity(): int
    + getA(): double
    + getB(): double
    + getMu(): double
    + getTotalRequests(): int
  }

  class BookingRequest {
    - sourceId: int
    - seqNo: int
    - sessionId: int
    - seatIds: int[]
    - ticketsCount: int
    - createdAt: double
    - enqueuedAt: double
    - serviceStartAt: double
    - serviceEndAt: double
    - state: BookingState
    --
    + priority(): int
    + label(): String
    + getState(): BookingState
    + markQueued(t: double): void
    + markRejected(t: double): void
    + markServing(t: double, endAt: double): void
    + markServed(): void
    + waitTime(): double
    + serviceTime(): double
    + sojournTime(): double
  }

  enum BookingState {
    CREATED
    QUEUED
    SERVING
    SERVED
    REJECTED
  }
}

package "Элементы СМО" {
  class BookingSource {
    - id: int
    - a: double
    - b: double
    - generated: int
    --
    + nextInterval(): double
    + buildRequest(now: double): BookingRequest
  }

  class SlotBuffer {
    - slots: BookingRequest[]
    --
    + capacity(): int
    + occupiedCount(): int
    + firstEmptySlot(): int
    + place(slot: int, req: BookingRequest): void
    + takeOut(slot: int): BookingRequest
    + slotOf(req: BookingRequest): int
    + requestsOfSource(sourceId: int): BookingRequest[]
    + highestPrioritySourceId(): int
    + lowestPrioritySourceId(): int
    + snapshot(): BookingRequest[]
  }

  class BookingServer {
    - id: int
    - mu: double
    - current: BookingRequest
    - busyTotal: double
    --
    + isIdle(): boolean
    + beginService(req: BookingRequest, now: double): double
    + complete(now: double): BookingRequest
    + getBusyTotal(): double
  }
}

package "Диспетчеры и дисциплины" {
  class PlacementDispatcher <<ДП>> {
    - buffer: SlotBuffer
    - admission: AdmissionPolicy
    - rejection: RejectionPolicy
    - stats: StatsCollector
    - journal: EventJournal
    --
    + placeRequest(req: BookingRequest, now: double): void
  }

  class SelectionDispatcher <<ДВ>> {
    - buffer: SlotBuffer
    - servers: BookingServer[]
    - calendar: EventCalendar
    - requestPolicy: RequestSelectionPolicy
    - devicePolicy: DevicePolicy
    - journal: EventJournal
    --
    + dispatch(now: double): void
  }

  interface AdmissionPolicy <<Д1ОЗ>> {
    + findSlot(buffer: SlotBuffer): int
  }
  class FirstFreeSlotPolicy <<Д1ОЗ3>> {
    .. Д1ОЗ3 ..
    первое свободное место от начала
    сдвига очереди нет
  }

  interface RejectionPolicy <<Д1ОО>> {
    + chooseVictim(buffer: SlotBuffer, incoming: BookingRequest): BookingRequest
  }
  class LowestPriorityRejection <<Д1ОО2>> {
    .. Д1ОО2 ..
    отказ: наибольший номер источника в буфере
    среди равных: самая поздняя по createdAt
    новая ниже всех: отказ получает она сама
    заявки на приборах не вытесняются
  }

  interface RequestSelectionPolicy <<Д2Б>> {
    + next(buffer: SlotBuffer): BookingRequest
    + currentPackage(): BookingRequest[]
  }
  class PackagePriorityPolicy <<Д2Б5>> {
    - pkg: Deque<BookingRequest>
    .. Д2Б5 ..
    пакет пуст: снимок заявок источника
    с наименьшим номером, FIFO по createdAt
    пакет не расширяется, его делят все приборы
    выбитые заявки пропускаются в next()
  }

  interface DevicePolicy <<Д2П>> {
    + hasIdle(servers: BookingServer[]): boolean
    + pickDevice(servers: BookingServer[]): int
    + pointer(): int
  }
  class RingDevicePolicy <<Д2П2>> {
    - ptr: int
    .. Д2П2 ..
    поиск свободного прибора по кольцу от ptr
    после выбора i: ptr := (i + 1) mod m
    единственный указатель в варианте 10
  }
}

package "Ядро моделирования" {
  class Simulation {
    - config: SimulationConfig
    - sources: BookingSource[]
    - buffer: SlotBuffer
    - servers: BookingServer[]
    - calendar: EventCalendar
    - placement: PlacementDispatcher
    - selection: SelectionDispatcher
    - stats: StatsCollector
    - journal: EventJournal
    - now: double
    - generated: int
    --
    + step(): boolean
    + runRealization(n: int): void
    + totalTime(): double
  }

  class EventCalendar {
    - queue: PriorityQueue<TimedEvent>
    --
    + push(ev: TimedEvent): void
    + pop(): TimedEvent
    + isEmpty(): boolean
    + snapshot(): TimedEvent[]
  }

  class TimedEvent {
    - time: double
    - kind: EventKind
    - sourceId: int
    - serverId: int
  }

  enum EventKind {
    ARRIVAL
    RELEASE
  }

  class PrecisionController {
    - config: SimulationConfig
    - t: double = 1.643
    - delta: double = 0.1
    - n0: int = 100
    --
    + requiredN(p: double): int
    + findN(): ResultTable
  }
}

package "Статистика и отображение" {
  class StatsCollector {
    - perSource: SourceStat[]
    .. ОР1 ..
    таблица 1 по источникам, таблица 2 по приборам
    Kисп = busyTotal / totalTime
    --
    + onGenerated(r: BookingRequest): void
    + onRejected(r: BookingRequest): void
    + onServed(r: BookingRequest): void
    + totalRejectProbability(): double
    + buildTable(servers: BookingServer[], totalTime: double): ResultTable
  }

  class SourceStat {
    - generated: int
    - served: int
    - rejected: int
    - sumWait: double
    - sumWait2: double
    - sumService: double
    - sumService2: double
    --
    + pReject(): double
    + meanWait(): double
    + meanService(): double
    + meanSojourn(): double
    + varWait(): double
    + varService(): double
  }

  class ResultTable {
    - sourceRows: SourceStat[]
    - deviceUtilization: double[]
  }

  class EventJournal {
    - entries: JournalEntry[]
    --
    + log(kind: JournalKind, req: BookingRequest, t: double): void
    + entries(): JournalEntry[]
  }

  class JournalEntry {
    - time: double
    - kind: JournalKind
    - request: BookingRequest
  }

  enum JournalKind {
    GENERATED
    BUFFERED
    REJECTED_NEW
    EVICTED
    PACKAGE_FORMED
    PICKED_FROM_PACKAGE
    SENT_TO_DEVICE
    SERVED
  }

  class StepRenderer <<ОД1>> {
    - calendar: EventCalendar
    - buffer: SlotBuffer
    - servers: BookingServer[]
    - requestPolicy: RequestSelectionPolicy
    - devicePolicy: DevicePolicy
    - journal: EventJournal
    - stats: StatsCollector
    --
    + render(now: double): void
  }

  class ResultPrinter <<ОР1>> {
    + print(table: ResultTable): void
  }
}

BookingRequest --> BookingState
BookingSource ..> BookingRequest : создаёт
SlotBuffer o-- "0..*" BookingRequest
BookingServer --> "0..1" BookingRequest : обслуживает

Simulation --> SimulationConfig
Simulation o-- "1..*" BookingSource
Simulation o-- "1..*" BookingServer
Simulation *-- SlotBuffer
Simulation *-- EventCalendar
Simulation *-- StatsCollector
Simulation *-- EventJournal
Simulation *-- PlacementDispatcher
Simulation *-- SelectionDispatcher

PlacementDispatcher --> SlotBuffer
PlacementDispatcher --> AdmissionPolicy
PlacementDispatcher --> RejectionPolicy
PlacementDispatcher --> StatsCollector
PlacementDispatcher --> EventJournal

SelectionDispatcher --> SlotBuffer
SelectionDispatcher --> BookingServer
SelectionDispatcher --> EventCalendar
SelectionDispatcher --> RequestSelectionPolicy
SelectionDispatcher --> DevicePolicy
SelectionDispatcher --> EventJournal

AdmissionPolicy <|.. FirstFreeSlotPolicy
RejectionPolicy <|.. LowestPriorityRejection
RequestSelectionPolicy <|.. PackagePriorityPolicy
DevicePolicy <|.. RingDevicePolicy

EventCalendar o-- "0..*" TimedEvent
TimedEvent --> EventKind
EventJournal o-- "0..*" JournalEntry
JournalEntry --> JournalKind

StatsCollector *-- "1..*" SourceStat
StatsCollector ..> ResultTable : формирует
PrecisionController ..> Simulation : запускает реализации
PrecisionController --> ResultTable
StepRenderer --> EventCalendar
StepRenderer --> SlotBuffer
StepRenderer --> BookingServer
StepRenderer --> RequestSelectionPolicy
StepRenderer --> DevicePolicy
StepRenderer --> EventJournal
StepRenderer --> StatsCollector
ResultPrinter ..> ResultTable

note top of Simulation
Триггеры: ARRIVAL запускает ДП (placeRequest), затем ДВ (dispatch).
RELEASE освобождает прибор и запускает ДВ.
ДП работает только с буфером и о приборах не знает.
Статистика: onGenerated при генерации, onRejected при отказе
(новая или выбитая), onServed при RELEASE.
Генерация прекращается после N-й заявки, работа заканчивается
после выхода последней заявки из системы.
Атрибуты всех классов закрыты (private), состояние меняется только методами.
end note

@enduml
