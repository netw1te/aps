@startuml class_booking_v10
title Модульная структура модели — бронирование билетов (вариант 10)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "Данные" {
  class SimulationConfig {
    + sourceCount: int
    + deviceCount: int
    + bufferCapacity: int
    + a: double
    + b: double
    + mu: double
    + totalRequests: int
  }

  class BookingRequest {
    - sourceId: int
    - seqNo: int
    - sessionId: int
    - seatIds: int[]
    - ticketsCount: int
    - createdAt: double
    - enqueuedAt: double
    - serviceStartAt: double
    - serviceEndAt: double
    - state: BookingState
    --
    + priority(): int
    + label(): String
    + waitTime(): double
    + serviceTime(): double
    + sojournTime(): double
  }

  enum BookingState {
    CREATED
    QUEUED
    SERVING
    SERVED
    REJECTED
  }
}

package "Элементы СМО" {
  class BookingSource {
    - id: int
    - a: double
    - b: double
    - generated: int
    --
    + nextInterval(): double
    + buildRequest(now: double): BookingRequest
  }

  class SlotBuffer {
    - slots: BookingRequest[]
    --
    + capacity(): int
    + occupiedCount(): int
    + firstEmptySlot(): int
    + place(slot: int, req: BookingRequest): void
    + takeOut(slot: int): BookingRequest
    + slotOf(req: BookingRequest): int
    + requestsOfSource(sourceId: int): BookingRequest[]
    + lowestPrioritySourceId(): int
  }

  class BookingServer {
    - id: int
    - mu: double
    - current: BookingRequest
    - busyTotal: double
    --
    + isIdle(): boolean
    + beginService(req: BookingRequest, now: double): double
    + complete(now: double): BookingRequest
  }
}

package "Диспетчеры и дисциплины" {
  class PlacementDispatcher <<ДП>> {
    + onArrival(req: BookingRequest, now: double): void
  }

  class SelectionDispatcher <<ДВ>> {
    + dispatch(now: double): void
  }

  interface AdmissionPolicy <<Д1ОЗ>> {
    + findSlot(buffer: SlotBuffer): int
  }
  class FirstFreeSlotPolicy <<Д1ОЗ3>> {
  }

  interface RejectionPolicy <<Д1ОО>> {
    + chooseVictim(buffer: SlotBuffer, incoming: BookingRequest): BookingRequest
  }
  class LowestPriorityRejection <<Д1ОО2>> {
  }

  interface RequestSelectionPolicy <<Д2Б>> {
    + next(buffer: SlotBuffer): BookingRequest
    + onEvicted(req: BookingRequest): void
  }
  class PackagePriorityPolicy <<Д2Б5>> {
    - pkg: Deque<BookingRequest>
    --
    + currentPackage(): BookingRequest[]
  }

  interface DevicePolicy <<Д2П>> {
    + pickDevice(servers: BookingServer[]): int
  }
  class RingDevicePolicy <<Д2П2>> {
    - pointer: int
    --
    + pointer(): int
  }
}

package "Ядро моделирования" {
  class Simulation {
    - config: SimulationConfig
    - sources: BookingSource[]
    - buffer: SlotBuffer
    - servers: BookingServer[]
    - calendar: EventCalendar
    - placement: PlacementDispatcher
    - selection: SelectionDispatcher
    - stats: StatsCollector
    - now: double
    - generated: int
    --
    + step(): boolean
    + runRealization(n: int): void
    + totalTime(): double
  }

  class EventCalendar {
    - queue: PriorityQueue<TimedEvent>
    --
    + push(ev: TimedEvent): void
    + pop(): TimedEvent
    + isEmpty(): boolean
    + snapshot(): TimedEvent[]
  }

  class TimedEvent {
    - time: double
    - kind: EventKind
    - sourceId: int
    - serverId: int
  }

  enum EventKind {
    ARRIVAL
    RELEASE
  }

  class PrecisionController {
    - t: double = 1.643
    - delta: double = 0.1
    - n0: int = 100
    --
    + requiredN(p: double): int
    + findN(cfg: SimulationConfig): ResultTable
  }
}

package "Статистика и отображение" {
  class StatsCollector {
    - perSource: SourceStat[]
    --
    + onGenerated(r: BookingRequest): void
    + onRejected(r: BookingRequest): void
    + onServed(r: BookingRequest): void
    + totalRejectProbability(): double
    + buildTable(servers: BookingServer[], totalTime: double): ResultTable
  }

  class SourceStat {
    - generated: int
    - served: int
    - rejected: int
    - sumWait: double
    - sumWait2: double
    - sumService: double
    - sumService2: double
    --
    + pReject(): double
    + meanWait(): double
    + meanService(): double
    + meanSojourn(): double
    + varWait(): double
    + varService(): double
  }

  class ResultTable {
    - sourceRows: SourceStat[]
    - deviceUtilization: double[]
  }

  class StepRenderer <<ОД1>> {
    + render(sim: Simulation): void
  }

  class ResultPrinter <<ОР1>> {
    + print(table: ResultTable): void
  }
}

BookingRequest --> BookingState
BookingSource ..> BookingRequest : создаёт
SlotBuffer o-- "0..*" BookingRequest
BookingServer --> "0..1" BookingRequest : обслуживает

Simulation --> SimulationConfig
Simulation o-- "1..*" BookingSource
Simulation o-- "1..*" BookingServer
Simulation *-- SlotBuffer
Simulation *-- EventCalendar
Simulation *-- StatsCollector
Simulation *-- PlacementDispatcher
Simulation *-- SelectionDispatcher

PlacementDispatcher --> AdmissionPolicy
PlacementDispatcher --> RejectionPolicy
PlacementDispatcher --> RequestSelectionPolicy : onEvicted
PlacementDispatcher --> SlotBuffer
PlacementDispatcher --> StatsCollector

SelectionDispatcher --> RequestSelectionPolicy
SelectionDispatcher --> DevicePolicy
SelectionDispatcher --> SlotBuffer
SelectionDispatcher --> BookingServer
SelectionDispatcher --> EventCalendar

AdmissionPolicy <|.. FirstFreeSlotPolicy
RejectionPolicy <|.. LowestPriorityRejection
RequestSelectionPolicy <|.. PackagePriorityPolicy
DevicePolicy <|.. RingDevicePolicy

EventCalendar o-- "0..*" TimedEvent
TimedEvent --> EventKind

StatsCollector *-- "1..*" SourceStat
StatsCollector ..> ResultTable : формирует
PrecisionController ..> Simulation : запускает реализации
PrecisionController --> ResultTable
StepRenderer ..> Simulation
ResultPrinter ..> ResultTable

note right of FirstFreeSlotPolicy
Д1ОЗ3: первое свободное место от начала
буфера, сдвига очереди нет.
end note

note right of LowestPriorityRejection
Д1ОО2: отказ получает заявка источника с наибольшим
номером (низший приоритет) среди заявок буфера.
Среди нескольких таких — самая поздняя по createdAt.
Если новая заявка имеет ещё более низкий приоритет,
чем жертва, chooseVictim возвращает саму новую заявку.
Заявки на приборах не вытесняются.
end note

note right of PackagePriorityPolicy
Д2Б5: когда пакет пуст, берётся источник с наименьшим
номером среди заявок буфера и фиксируется снимок его заявок
(по createdAt, FIFO). Новые заявки этого источника в пакет
не попадают. Вытесненная заявка удаляется из пакета (onEvicted).
end note

note right of RingDevicePolicy
Д2П2: поиск свободного прибора по кольцу от pointer;
после выбора прибора i pointer = (i + 1) mod m.
Единственный указатель в варианте 10.
end note

note bottom of StatsCollector
ОР1: Таблица 1 по источникам (число заявок, Pотк, Tпреб, Tож, Tобсл,
дисперсии Tож и Tобсл) и Таблица 2 по приборам
(Kисп = busyTotal / totalTime).
end note
@enduml
